<Window x:Class="CyberSecurityAwarenessBotGUI.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memory Manager" Height="400" Width="480" MinWidth="420" MinHeight="320">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="FactsList" Grid.Row="0" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="EditButton" Content="Edit" Width="80" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Delete" Width="80" Click="DeleteButton_Click" Margin="8,0,0,0"/>
            <Button x:Name="ClearButton" Content="Clear All" Width="80" Click="ClearButton_Click" Margin="8,0,0,0"/>
            <Button x:Name="CloseButton" Content="Close" Width="80" Click="CloseButton_Click" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>