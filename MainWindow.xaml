<Window x:Class="CyberSecurityAwarenessBotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityAwarenessBotGUI"
        mc:Ignorable="d"
        Title="Cyber Security Awareness Bot" Height="570" Width="890" MinWidth="890" MinHeight="570">

    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Background="#FF1F2937" Height="48">
            <DockPanel>
                <Button x:Name="SidebarToggleButton" Width="31" Height="33" Margin="6" Padding="0" Click="SidebarToggleButton_Click" BorderBrush="{x:Null}" Background="{x:Null}">
                    <TextBlock Text="☰" Foreground="White" FontSize="16"/>
                </Button>
                <TextBlock Text="Cyber Security Awareness Bot" VerticalAlignment="Center" Foreground="White" FontSize="16" Margin="8,0"/>
                <!-- Memory manager and Exit buttons on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button x:Name="MemoryButton" Width="36" Height="32" Margin="0,0,6,0" Click="MemoryButton_Click">
                        <TextBlock Text="🧠" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ExitButton" Width="84" Height="32" Click="ExitButton_Click">
                        <TextBlock Text="Exit" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <Border x:Name="LeftPanel" Grid.Column="0" Background="#FFF" BorderBrush="#FFE6EEF5" BorderThickness="0,0,1,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Conversations" Margin="0,4" FontWeight="SemiBold" />
                    <ListBox x:Name="ConversationList" Height="130" Panel.ZIndex="0" MaxHeight="130" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="ConversationList_SelectionChanged">

                    </ListBox>
                    <TextBlock Text="History" Margin="0,8,0,4" FontWeight="SemiBold" />
                    <ListBox x:Name="HistoryList" Height="120" Panel.ZIndex="0" MaxHeight="120" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="HistoryList_SelectionChanged" />
                    <Button x:Name="NewConversationButton" Content="New Conversation" Height="30" Margin="0,8,0,0" Click="NewConversationButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Chat area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#FFF" BorderBrush="#FFE6EEF5" BorderThickness="0,0,0,1" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="36" Height="36">
                            <Ellipse Fill="#FF3B82F6"/>
                            <!-- simple bot icon using emoji which designer can render -->
                            <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="8,0">
                            <TextBlock Text="Security Bot" FontWeight="SemiBold"/>
                            <TextBlock Text="Active" FontSize="11" Foreground="#FF6B7280"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Messages list (simple, populated from code-behind) -->
                <ListBox x:Name="MessagesList" Grid.Row="1" Background="#FFF8FAFC" BorderThickness="0" Padding="8"/>

                <!-- Input -->
                <Border Grid.Row="2" Background="#FFF" BorderBrush="#FFE6EEF5" BorderThickness="1,1,0,0" Padding="8" Grid.ColumnSpan="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputTextBox"
                                 Grid.Column="0"
                                 AcceptsReturn="True"
                                 MinHeight="36"
                                 Margin="0,0,8,0"
                                 KeyDown="InputTextBox_KeyDown"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 TextWrapping="Wrap"/>

                        <Button x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                Height="36"
                                Width="50"
                                Margin="0,0,0,0"
                                Click="SendButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
